             CommandLineLogger.LogFatal($"Cannot parse path from input: {path}", 1);
         }
 
-        Uri uri = null;
-        try
-        {
-            Uri.TryCreate(path, UriKind.RelativeOrAbsolute, out uri);
-        }
-        catch (InvalidOperationException)
