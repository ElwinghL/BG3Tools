# =============================================================================
# BG3 Mod Downloader - exemple de configuration
# =============================================================================
#
# Copie ce fichier sous le nom .env puis renseigne les valeurs.
#
# IMPORTANT :
# - Ne partage jamais ton fichier .env.
# - Ne commit jamais .env dans Git.
# - Les lignes commençant par # sont des commentaires.
#
# =============================================================================


# -----------------------------------------------------------------------------
# NEXUS MODS
# -----------------------------------------------------------------------------
#
# Clé API Nexus Mods.
# Disponible dans les paramètres de ton compte Nexus Mods -> API Keys.
#
NEXUS_API_KEY=


# -----------------------------------------------------------------------------
# mod.io — clé API
# -----------------------------------------------------------------------------
#
# Clé API mod.io.
# Disponible depuis : https://mod.io/apikey
#
MODIO_API_KEY=


# -----------------------------------------------------------------------------
# mod.io — identifiant utilisateur
# -----------------------------------------------------------------------------
#
# Identifiant de TON compte utilisateur mod.io.
#
# Le script construit automatiquement l'URL de l'API utilisateur :
#
#   https://u-{MOD_IO_USER_ID}.modapi.io/v1
#
# Cette API permet notamment d'appeler /me/subscribed et donc de récupérer
# directement les mods auxquels ton compte est abonné.
#
# Aucun Game ID BG3 n'est nécessaire.
#
# Exemple :
#   MOD_IO_USER_ID=123456
#
MOD_IO_USER_ID=


# -----------------------------------------------------------------------------
# mod.io — API Base (OPTIONNEL)
# -----------------------------------------------------------------------------
#
# Tu peux laisser cette variable vide.
#
# Si MOD_IO_USER_ID est renseigné, le script construit automatiquement l'URL.
#
# Tu peux cependant fournir directement l'URL API utilisateur :
#
#   MODIO_API_BASE=https://u-123456.modapi.io/v1
#
MODIO_API_BASE=


# -----------------------------------------------------------------------------
# mod.io — Personal Access Token (OPTIONNEL)
# -----------------------------------------------------------------------------
#
# Personal Access Token mod.io.
# Disponible dans :
#   mod.io -> Settings -> API -> Personal Access Tokens
#
# Si renseigné, le script l'envoie comme :
#   Authorization: Bearer <token>
#
# Tu peux laisser cette variable vide si la clé API suffit pour les requêtes
# GET utilisées par le script.
#
MODIO_ACCESS_TOKEN=
