                            </Image>
                        </StackPanel>
                        <Image Source="{StaticResource FooterCenterDecorImage}" Stretch="None" HorizontalAlignment="Center" Margin="0,-20,0,0"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </ControlTemplate>
    </ls:UIWidget.Template>
