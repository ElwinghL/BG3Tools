<?xml version="1.0" encoding="UTF-8"?>
<save>
    <version major="4" minor="8" revision="0" build="500"/>
    <region id="Config">
        <node id="root">
            <children>
                <node id="Conflicts"/>
                <node id="Dependencies">
                    <children>
                        <!-- NMCM: this is the framework the bridge's page and slot claim depend on.
                             The dependency guarantees this module loads AFTER NMCM, which is what
                             lets the slot 4 label handle below win and PROC_NMCM_* be visible to our
                             goal (Osiris goals merge by file name across the whole dependency tree). -->
                        <node id="ModuleShortDesc">
                            <attribute id="Folder" type="LSString" value="NMCM_ca8bfe06-88ec-a4e7-b49e-44eb5658f434"/>
                            <attribute id="MD5" type="LSString" value=""/>
                            <attribute id="Name" type="LSString" value="Native Mod Configuration Menu - NMCM"/>
                            <attribute id="PublishHandle" type="uint64" value="6293954"/>
                            <attribute id="UUID" type="guid" value="ca8bfe06-88ec-a4e7-b49e-44eb5658f434"/>
                            <attribute id="Version64" type="int64" value="36169538802286606"/>
                        </node>
                        <!-- Mod Configuration Menu (MCM / BG3MCM): the bridge's Lua calls
                             Mods.BG3MCM.MCMAPI:SetSettingValue(...), so it must load after MCM too.
                             Version64 read straight from Visible Shields Universal's own meta.lsx
                             dependency declaration (its shipped .pak), not guessed. -->
                        <node id="ModuleShortDesc">
                            <attribute id="Folder" type="LSString" value="BG3MCM"/>
                            <attribute id="MD5" type="LSString" value=""/>
                            <attribute id="Name" type="FixedString" value="Mod Configuration Menu"/>
                            <attribute id="PublishHandle" type="uint64" value="0"/>
                            <attribute id="UUID" type="FixedString" value="755a8a72-407f-4f0d-9a33-274ac0f0b53d"/>
                            <attribute id="Version64" type="int64" value="41658298700660736"/>
                        </node>
                        <!-- Visible Shields - Universal itself: not called into directly (the bridge
                             only ever writes into MCM's own storage, which VisibleShieldsU reads
                             through Mods.BG3MCM.MCMAPI:GetSettingValue / a local MCM.Get helper), but
                             the dependency fixes load order so the bridge is always present alongside
                             the mod it configures, and documents the relationship for anyone
                             inspecting load order. UUID, Folder and Version64 read from
                             VisibleShieldsU.pak's own real meta.lsx, not guessed. -->
                        <node id="ModuleShortDesc">
                            <attribute id="Folder" type="LSString" value="VisibleShieldsU"/>
                            <attribute id="MD5" type="LSString" value=""/>
                            <attribute id="Name" type="LSString" value="Visible Shields - Universal"/>
                            <attribute id="PublishHandle" type="uint64" value="0"/>
                            <attribute id="UUID" type="FixedString" value="8cc00893-60a1-4240-88fb-f0bf87b95e74"/>
                            <attribute id="Version64" type="int64" value="36028799166447618"/>
                        </node>
                    </children>
                </node>
                <node id="ModuleInfo">
                    <attribute id="Author" type="LSString" value="Elwingh"/>
                    <attribute id="CharacterCreationLevelName" type="FixedString" value=""/>
                    <attribute id="Description" type="LSString" value="Unofficial NMCM (gamepad/Honour-friendly) front end for Visible Shields Universal's existing MCM settings: share_mode and debug_level. Does not modify Visible Shields Universal's own .pak; writes into MCM's storage exactly as Visible Shields Universal's own MCM page would."/>
                    <attribute id="Folder" type="LSString" value="VisibleShields_NMCM_Bridge"/>
                    <attribute id="LobbyLevelName" type="FixedString" value=""/>
                    <attribute id="MD5" type="LSString" value=""/>
                    <attribute id="MenuLevelName" type="FixedString" value=""/>
                    <attribute id="Name" type="LSString" value="Visible Shields - NMCM Bridge"/>
                    <attribute id="NumPlayers" type="uint8" value="4"/>
                    <attribute id="PhotoBooth" type="FixedString" value=""/>
                    <attribute id="StartupLevelName" type="FixedString" value=""/>
                    <attribute id="Tags" type="LSString" value=""/>
                    <attribute id="Type" type="FixedString" value="Add-on"/>
                    <attribute id="UUID" type="FixedString" value="d9f90e77-b06b-4f62-b777-7f31718e42e0"/>
                    <attribute id="Version64" type="int64" value="36028797018963968"/>
                    <children>
                        <node id="PublishVersion">
                            <attribute id="Version64" type="int64" value="36028797018963968"/>
                        </node>
                        <node id="Scripts"/>
                        <node id="TargetModes">
                            <children>
                                <node id="Target">
                                    <attribute id="Object" type="FixedString" value="Story"/>
                                </node>
                            </children>
                        </node>
                    </children>
                </node>
            </children>
        </node>
    </region>
</save>
