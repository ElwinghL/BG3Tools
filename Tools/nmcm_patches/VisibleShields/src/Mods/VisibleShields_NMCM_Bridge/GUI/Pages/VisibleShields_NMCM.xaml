                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- Footer. Back and Reset are vanilla handles (arrive pre-translated in all 15
                     languages), same choice as AbsoluteDefeat_NMCM_Bridge. Reset fires this mod's
