                            <Image Source="{StaticResource FooterSideDecorImage}" Stretch="None" VerticalAlignment="Center" Margin="-20,0"/>

                            <ls:LSButton x:Name="BackBtn" HorizontalAlignment="Center" Style="{StaticResource BigBrownButtonStyle}"
