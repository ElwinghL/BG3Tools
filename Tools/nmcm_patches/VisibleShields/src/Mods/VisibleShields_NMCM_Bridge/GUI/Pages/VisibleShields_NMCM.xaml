<ls:UIWidget x:Name="VisibleShieldsNMCMPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ls="clr-namespace:ls;assembly=Code"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             ls:UIWidget.ContextName="GameMenu"
             d:DesignWidth="3840" d:DesignHeight="2160">

 <!-- NMCM slot 4 page for the Visible Shields NMCM Bridge. Assembled from
      Tools/bg3-nmcm/examples/controls/page-skeleton.xaml plus one drop-down-of-N-values row
      (examples/controls/list, the native NMCM enum control: share_mode has 3 fixed choices in
      Visible Shields Universal's own MCM_blueprint.json, so this is the correct control, not a set
      of radio-style checkboxes) and one numeric stepper row (examples/controls/slider, range 0-2 to
      match debug_level's Options.Min/Max, same pattern already used by AbsoluteDefeat_NMCM_Bridge).
      ContextName="GameMenu" is what makes every binding below live. -->

    <ls:UIWidget.Template>
        <ControlTemplate>
            <ControlTemplate.Resources>

                <ImageSource x:Key="ItemBG">pack://application:,,,/Core;component/Assets/Options/li_bg.png</ImageSource>
                <ImageSource x:Key="ItemBGHL">pack://application:,,,/Core;component/Assets/Options/li_bg_active.png</ImageSource>
                <ImageSource x:Key="SideDecorations">pack://application:,,,/Core;component/Assets/Options/decors_header.png</ImageSource>

                <!-- Drop-down art, needed by the share_mode row (examples/controls/list). -->
                <BitmapImage x:Key="PillDefault"    UriSource="pack://application:,,,/Core;component/Assets/Options/dropdownBox_wide_d.png"/>
                <BitmapImage x:Key="PillHighlight"  UriSource="pack://application:,,,/Core;component/Assets/Options/dropdownBox_wide_h.png"/>
                <BitmapImage x:Key="RoundDefault"   UriSource="pack://application:,,,/Core;component/Assets/Buttons/btn_small_round_d.png"/>
                <BitmapImage x:Key="RoundHighlight" UriSource="pack://application:,,,/Core;component/Assets/Buttons/btn_small_round_h.png"/>
                <BitmapImage x:Key="ArrowClosed"    UriSource="pack://application:,,,/Core;component/Assets/Options/input_dropUpArrow_d.png"/>
                <BitmapImage x:Key="ArrowClosedHL"  UriSource="pack://application:,,,/Core;component/Assets/Options/input_dropUpArrow_h.png"/>
                <BitmapImage x:Key="ArrowOpen"      UriSource="pack://application:,,,/Core;component/Assets/Options/input_dropDownArrow_d.png"/>
                <ImageSource x:Key="FlyoutSelected">pack://application:,,,/Core;component/Assets/Options/input_dropdown_flyout_selected.png</ImageSource>

                <BitmapImage x:Key="DividerImage"          UriSource="pack://application:,,,/Core;component/Assets/Lobby/divider_lobby.png"/>
                <BitmapImage x:Key="FooterSideDecorImage"  UriSource="pack://application:,,,/Core;component/Assets/DMSettings/footer_sideDecors.png"/>
                <BitmapImage x:Key="FooterCenterDecorImage" UriSource="pack://application:,,,/Core;component/Assets/DMSettings/footer_centerDecors.png"/>

                <Style x:Key="RowLabel" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Margin" Value="60,0,0,0"/>
                    <Setter Property="MaxWidth" Value="1100"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="FontSize" Value="{StaticResource ScaledDefaultFontSize}"/>
                    <Setter Property="Foreground" Value="{StaticResource LS_accent75TxtColor}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource LS_tint100}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="RowHighlight" TargetType="Image">
                    <Setter Property="Stretch" Value="Fill"/>
                    <Setter Property="Height" Value="116"/>
                    <Setter Property="Source" Value="{StaticResource ItemBG}"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                            <Setter Property="Source" Value="{StaticResource ItemBGHL}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="SectionTitle" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="16,0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="{StaticResource ScaledIntermediateFontSize}"/>
                    <Setter Property="Foreground" Value="{StaticResource LS_tint100}"/>
                </Style>

                <Style x:Key="PreviewTitle" TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="FontSize" Value="{StaticResource ScaledLargeFontSize}"/>
                    <Setter Property="Foreground" Value="{StaticResource LS_tint100}"/>
                </Style>

                <Style x:Key="PreviewBody" TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Left"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Margin" Value="0,20"/>
                    <Setter Property="FontSize" Value="{StaticResource ScaledDefaultFontSize}"/>
                    <Setter Property="Foreground" Value="{StaticResource LS_accent75TxtColor}"/>
                </Style>

                <Style x:Key="GalleryItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                    <Setter Property="IsSelected" Value="False"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="IsSelected" Value="True"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Replica of the vanilla BaseComboBoxItemStyle, used by the drop down row's flyout. -->
                <ControlTemplate x:Key="FlyoutItemTemplate" TargetType="Button">
                    <Grid x:Name="fi" Background="Transparent" MinHeight="76">
                        <Rectangle x:Name="fibg" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{StaticResource FlyoutSelected}" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0"/>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseEnter">
                                <ls:LSPlaySound Sound="UI_Shared_Hover"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fibg" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <Style x:Key="FlyoutItemText" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="{StaticResource ScaledDefaultFontSize}"/>
                    <Setter Property="Foreground" Value="{StaticResource LS_accent75TxtColor}"/>
                </Style>

            </ControlTemplate.Resources>

            <Grid x:Name="GridRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource PageHeaderHeight}"/>
                    <RowDefinition/>
                    <RowDefinition Height="{StaticResource PageFooterHeight}"/>
                </Grid.RowDefinitions>

                <!-- The page announces itself on open: GetHostCharacter is undefined during
                     LevelLoaded/SavegameLoaded, so this is where the goal learns who is looking, and
                     it also re-applies the debug level mirror (see the goal file). -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Loaded">
                        <ls:LSPlaySound Sound="UI_HUD_NewGameSettings_Open"/>
                        <b:InvokeCommandAction Command="{Binding DataContext.TutorialEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                               CommandParameter="9ae292e9-206a-4ec8-87cc-fb991c0fc598"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <Image x:Name="MenuBackground" Grid.Row="0" Grid.RowSpan="3" Source="{StaticResource OptionsBackground}"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="UniformToFill"/>

                <ls:LSInputBinding PlayerId="{Binding CurrentPlayer.PlayerId}" BoundEvent="UICancel"
                                   Command="{Binding CustomEvent}" CommandParameter="CloseWidget"/>

                <Control Grid.Row="0" x:Name="TitleText" Template="{StaticResource PageHeader}"
                         Tag="{Binding Source='h15137cecgb5ffg4b04gbe74gfe1bd8058401', Converter={StaticResource TranslatedStringConverter}}"/>

                <Grid Grid.Row="1" Margin="0,10,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="900"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="600"/>
                    </Grid.ColumnDefinitions>

                    <!-- No card art shipped: leaving Grid.Column="0" empty is fine, the layout still
                         centres. -->

                    <ListBox x:Name="GalleryList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource GalleryItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Template>
                            <ControlTemplate>
                                <ScrollViewer HorizontalAlignment="Center" Padding="16,0" Height="1500" Width="Auto"
                                              Template="{StaticResource ScrollViewerTemplate}" Background="Transparent">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DecorativeGoldScrollBar}"/>
                                        <GridLength x:Key="Top">0</GridLength>
                                        <GridLength x:Key="Bottom">0</GridLength>
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>

                        <ListBoxItem IsHitTestVisible="False" Focusable="False">
                            <StackPanel Margin="0,40,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="{StaticResource SideDecorations}" Stretch="None" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding Source='he2b7a281g6450g4a36gb4e3g6a28e4ae7130', Converter={StaticResource TranslatedStringConverter}}"/>
                                <Image Source="{StaticResource SideDecorations}" Stretch="None" VerticalAlignment="Center">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="-1" CenterX="42"/>
                                    </Image.RenderTransform>
                                </Image>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Row 1: drop-down of 3 values, Visible Shields Universal setting
                             "share_mode" (enum, MCM_blueprint.json Options.Choices, 3 entries).
                             ONE UUID PER VALUE, never one per row (examples/controls/list law): the
                             identity of the flyout entry clicked IS the value, which is what makes
                             the list select directly instead of cycling. -->
                        <ListBoxItem Tag="SHARE">
                            <Grid Width="1800" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="MouseEnter">
                                        <ls:LSPlaySound Sound="UI_HUD_Options_OptionHover"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Image Grid.ColumnSpan="2" Style="{StaticResource RowHighlight}"/>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                           Text="{Binding Source='h613ceeeeg0fb7g41dcgb5f0g2ed1439dbced', Converter={StaticResource TranslatedStringConverter}}"/>

                                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,60,0" Width="868">

                                    <ls:LSToggleButton x:Name="ShareToggle" SoundID="UI_HUD_Options_ComboBox"
                                                       HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ls:LSToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ls:LSNineSliceImage Grid.Column="0" Grid.ColumnSpan="2" x:Name="pill"
                                                                         ImageSource="{StaticResource PillDefault}" Height="80" Slices="40" IsHitTestVisible="False"/>
                                                    <Image Grid.Column="1" x:Name="rnd" Source="{StaticResource RoundDefault}" Stretch="None"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
                                                    <Image Grid.Column="1" x:Name="arw" Source="{StaticResource ArrowClosed}" Stretch="None"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="pill" Property="ImageSource" Value="{StaticResource PillHighlight}"/>
                                                        <Setter TargetName="arw" Property="Source" Value="{StaticResource ArrowClosedHL}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="rnd" Property="Source" Value="{StaticResource RoundHighlight}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arw" Property="Source" Value="{StaticResource ArrowOpen}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ls:LSToggleButton.Template>
                                    </ls:LSToggleButton>

                                    <!-- The current value, drawn from the data: one collapsed
                                         TextBlock per choice, lit by whichever marker matches. -->
                                    <ItemsControl ItemsSource="{Binding CurrentPlayer.SelectedCharacter.Stats.Passives}"
                                                  IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock x:Name="v0" Visibility="Collapsed" Foreground="{StaticResource LS_accent100TxtColor}" FontSize="{StaticResource ScaledDefaultFontSize}"
                                                               Text="{Binding Source='hdbe58b28gb62bg4609g8dc5g3345791d7542', Converter={StaticResource TranslatedStringConverter}}"/>
                                                    <TextBlock x:Name="v1" Visibility="Collapsed" Foreground="{StaticResource LS_accent100TxtColor}" FontSize="{StaticResource ScaledDefaultFontSize}"
                                                               Text="{Binding Source='h5e236258g10dbg413bgbce2g8d007ec97843', Converter={StaticResource TranslatedStringConverter}}"/>
                                                    <TextBlock x:Name="v2" Visibility="Collapsed" Foreground="{StaticResource LS_accent100TxtColor}" FontSize="{StaticResource ScaledDefaultFontSize}"
                                                               Text="{Binding Source='h8cc01964g2d03g4474gb8dbg25bfb722cbc5', Converter={StaticResource TranslatedStringConverter}}"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Name.Str}" Value="VSNB_SHARE_0">
                                                        <Setter TargetName="v0" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name.Str}" Value="VSNB_SHARE_1">
                                                        <Setter TargetName="v1" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name.Str}" Value="VSNB_SHARE_2">
                                                        <Setter TargetName="v2" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- The flyout: one entry per value, one UUID per value, each
                                         entry closes the pill itself. -->
                                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=ShareToggle}"
                                           IsOpen="{Binding IsChecked, ElementName=ShareToggle}">
                                        <ls:LSNineSliceImage Style="{StaticResource PopoutNineSliceStyle}" MinWidth="{Binding ActualWidth, ElementName=ShareToggle}">
                                            <StackPanel Orientation="Vertical">
                                                <Button Template="{StaticResource FlyoutItemTemplate}" HorizontalContentAlignment="Stretch">
                                                    <TextBlock Style="{StaticResource FlyoutItemText}"
                                                               Text="{Binding Source='hdbe58b28gb62bg4609g8dc5g3345791d7542', Converter={StaticResource TranslatedStringConverter}}"/>
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="Click">
                                                            <b:InvokeCommandAction Command="{Binding DataContext.TutorialEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                                                   CommandParameter="fb60184c-3d6e-4b38-b29c-df8bec9b2645"/>
                                                            <b:ChangePropertyAction TargetName="ShareToggle" PropertyName="IsChecked" Value="False"/>
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </Button>
                                                <Button Template="{StaticResource FlyoutItemTemplate}" HorizontalContentAlignment="Stretch">
                                                    <TextBlock Style="{StaticResource FlyoutItemText}"
                                                               Text="{Binding Source='h5e236258g10dbg413bgbce2g8d007ec97843', Converter={StaticResource TranslatedStringConverter}}"/>
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="Click">
                                                            <b:InvokeCommandAction Command="{Binding DataContext.TutorialEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                                                   CommandParameter="32c26120-3c19-4c73-b498-f5793edf828c"/>
                                                            <b:ChangePropertyAction TargetName="ShareToggle" PropertyName="IsChecked" Value="False"/>
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </Button>
                                                <Button Template="{StaticResource FlyoutItemTemplate}" HorizontalContentAlignment="Stretch">
                                                    <TextBlock Style="{StaticResource FlyoutItemText}"
                                                               Text="{Binding Source='h8cc01964g2d03g4474gb8dbg25bfb722cbc5', Converter={StaticResource TranslatedStringConverter}}"/>
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="Click">
                                                            <b:InvokeCommandAction Command="{Binding DataContext.TutorialEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                                                   CommandParameter="036978b6-8468-44f7-9ff8-8fd4ff8e5363"/>
                                                            <b:ChangePropertyAction TargetName="ShareToggle" PropertyName="IsChecked" Value="False"/>
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </Button>
                                            </StackPanel>
                                        </ls:LSNineSliceImage>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </ListBoxItem>

                        <!-- Row 2: stepper, Visible Shields Universal setting "debug_level"
                             (slider_int, Options.Min=0, Options.Max=2 in MCM_blueprint.json). Same
                             numeric-mirror law as NMCM's own reference control and as
                             AbsoluteDefeat_NMCM_Bridge's own debug stepper: the Action Resource is a
                             MIRROR, never the owner, mirrored WITHOUT reading it (floor with a large
                             negative delta, then add the value the DB owns). -->
                        <ListBoxItem Tag="DEBUG">
                            <Grid Width="1800" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="MouseEnter">
                                        <ls:LSPlaySound Sound="UI_HUD_Options_OptionHover"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Image Grid.ColumnSpan="2" Style="{StaticResource RowHighlight}"/>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                           Text="{Binding Source='hb5f4e9f2g321ag420bgb00cg200e8965b8d5', Converter={StaticResource TranslatedStringConverter}}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Width="868"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,60,0">
                                    <Button Template="{StaticResource MinButton}" VerticalAlignment="Center">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="Click">
                                                <ls:LSPlaySound Sound="UI_HUD_Options_ToggleButton"/>
                                                <b:InvokeCommandAction Command="{Binding DataContext.TutorialEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                                       CommandParameter="de8b9707-b1f9-422a-a8d2-04d9aac1486e"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding CurrentPlayer.SelectedCharacter.Stats.ActionResources}"
                                                  IsHitTestVisible="False" VerticalAlignment="Center" Margin="20,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="barHost" Visibility="Collapsed" Width="640">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ls:LSProgressBar Grid.Column="0" Value="{Binding Value, Mode=OneWay}" Maximum="2"
                                                                      Minimum="0" Background="#E0000000" Height="24" VerticalAlignment="Center">
                                                        <ls:LSProgressBar.Foreground>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FF6E4A16" Offset="0.0"/>
                                                                <GradientStop Color="#FFD9A441" Offset="0.5"/>
                                                                <GradientStop Color="#FF6E4A16" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </ls:LSProgressBar.Foreground>
                                                    </ls:LSProgressBar>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0:0.#}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="{StaticResource ScaledDefaultFontSize}"
                                                               Foreground="{StaticResource LS_accent100TxtColor}"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding TypeId}" Value="VSNB_DebugG">
                                                        <Setter TargetName="barHost" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Template="{StaticResource PlusButton}" VerticalAlignment="Center">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="Click">
                                                <ls:LSPlaySound Sound="UI_HUD_Options_ToggleButton"/>
                                                <b:InvokeCommandAction Command="{Binding DataContext.TutorialEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                                       CommandParameter="a7f95a06-2458-414d-9bb7-c12553b56779"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                    </ListBox>

                    <Image Grid.Column="2" Source="{StaticResource DividerImage}" Stretch="None"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <StackPanel x:Name="Preview" Grid.Column="2" Margin="80,40,80,0"
                                VerticalAlignment="Top" Orientation="Vertical">

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=GalleryList}" Value="-1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource PreviewTitle}"
                                       Text="{Binding Source='h15137cecgb5ffg4b04gbe74gfe1bd8058401', Converter={StaticResource TranslatedStringConverter}}"/>
                            <TextBlock Style="{StaticResource PreviewBody}"
                                       Text="{Binding Source='h027b3b07gfa12g46eag954agf94b1ef15b74', Converter={StaticResource TranslatedStringConverter}}"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=GalleryList}" Value="SHARE">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource PreviewTitle}"
                                       Text="{Binding Source='h613ceeeeg0fb7g41dcgb5f0g2ed1439dbced', Converter={StaticResource TranslatedStringConverter}}"/>
                            <TextBlock Style="{StaticResource PreviewBody}"
                                       Text="{Binding Source='ha01ee40dg8fe7g43fdg89e8gd1555e6d5e60', Converter={StaticResource TranslatedStringConverter}}"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=GalleryList}" Value="DEBUG">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource PreviewTitle}"
                                       Text="{Binding Source='hb5f4e9f2g321ag420bgb00cg200e8965b8d5', Converter={StaticResource TranslatedStringConverter}}"/>
                            <TextBlock Style="{StaticResource PreviewBody}"
