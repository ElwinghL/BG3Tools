# Secrets
.env

# BG3 Mod TUI - config locale et dossier géré (chemins/liens spécifiques
# à la machine, ne doivent pas être versionnés)
/bg3modtools.toml
/native_mods_manifest.json
/BG3_Managed/

# Exports de profil (*.bg3profile.tar.zst, voir profile_archive.py) : la
# boîte de dialogue d'export peut par défaut proposer la racine du dépôt
# comme destination — ignoré pour ne pas committer un gros binaire par
# erreur si jamais un profil finit exporté là plutôt que dans son dossier
# voulu.
/*.bg3profile.tar.zst

# Environnement virtuel Python
.venv/
__pycache__/
*.pyc
*.egg-info/
/build/
/dist/
.vscode/

# Tout .claude/ est local (état d'agents, settings...) sauf TODO.md,
# volontairement suivi et partagé entre sessions/collaborateurs.
.claude/*
!.claude/TODO.md

# Outils tiers téléchargés : on garde la structure des dossiers (.gitkeep)
# mais on ignore les fichiers eux-mêmes (binaires/archives, pas notre code).

# Marqueur de version écrit par tools_manager.py dans chaque dossier
# d'outil, pour savoir si un nouveau téléchargement est nécessaire.
/Tools/**/.bg3modtools_version

/Tools/Archives_installees/**

/Tools/BG3-Load-Order-Optimizer/**/*.dll
/Tools/BG3-Load-Order-Optimizer/**/*.exe
/Tools/BG3-Load-Order-Optimizer/**/*.json
/Tools/BG3-Load-Order-Optimizer/**/*.txt

/Tools/BG3ModManager_Latest/**/*.dll
/Tools/BG3ModManager_Latest/**/*.exe
/Tools/BG3ModManager_Latest/**/*.config
/Tools/BG3ModManager_Latest/**/*.json
/Tools/BG3ModManager_Latest/**/*.log
/Tools/BG3ModManager_Latest/*.old-*

/Tools/Para-Tools/*.App
/Tools/Para-Tools/*.App.exe
/Tools/Para-Tools/*.pdb

/Tools/BG3 Script Extender/*.dll
/Tools/BG3 Script Extender/ScriptExtenderSettings.json

/Tools/ExportTools/**/*.dll
/Tools/ExportTools/**/*.exe
/Tools/ExportTools/**/*.json
/Tools/ExportTools/**/*.config

/Tools/Native Mod Loader/bin/*.dll

/Tools/MoreReactiveCompanionsConfigApp/*.exe
/Tools/MoreReactiveCompanionsConfigApp/*.png
/Tools/MoreReactiveCompanionsConfigApp/*.txt

# Archive Nexus déposée manuellement en attente de traitement par
# tools_manager.py (compte non-Premium, pas de téléchargement direct
# possible — voir _install_nexus_tool) : ne doit jamais être commitée,
# qu'elle soit encore en attente ou déjà consommée (déplacée sous
# Archives_installees/, déjà ignoré ci-dessus).
/Tools/*.zip
/Tools/*.rar
/Tools/*.7z

# Sources téléchargées depuis GitHub (pas de release/.pak fourni — voir
# compat_framework.py, qui reconstruit le .pak localement à partir
# d'elles via Divine.exe) : pas notre code.
/Tools/BG3-Compatibility-Framework/**

# Rust (crates sous rust/, ex. pak_reader_rs) : artefacts de build Cargo,
# pas notre code. Cargo.lock reste versionné (verrouiller les versions
# évite les régressions silencieuses lors d'un nouveau `cargo build`).
/rust/**/target/
